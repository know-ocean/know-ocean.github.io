---
layout: null
sitemap: false
---
[
    {% for post in site.posts %
    }
    {
        "title": {
            { post.title | jsonify
            }
        },
        "url": {
            { post.url | relative_url | jsonify
            }
        },
        "excerpt": {
            { post.excerpt | strip_html | normalize_whitespace | jsonify
            }
        },
        "content": {
            { post.content | strip_html | normalize_whitespace | jsonify
            }
        }
    }{% unless forloop.last %
    },
    {% endunless %
    }
  {% endfor %
    }
  {% assign searchable_pages = site.pages | where_exp: "p",
        "p.title != nil" | where_exp: "p",
        "p.indexing != false" %
    }
  {% for page in searchable_pages %
    }
    {% if site.posts.size > 0 or forloop.first == false %
    },
    {% endif %
    }
    {
        "title": {
            { page.title | jsonify
            }
        },
        "url": {
            { page.url | relative_url | jsonify
            }
        },
        "excerpt": {
            { page.excerpt | default: page.description | strip_html | normalize_whitespace | jsonify
            }
        },
        "content": {
            { page.content | strip_html | normalize_whitespace | jsonify
            }
        }
    }
  {% endfor %
    }
]